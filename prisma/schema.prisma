generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Moneda {
  COP
  BS
  USD
  USDT
}

enum CategoriaCuenta {
  BASE_COP
  OPERATIVA
}

enum TipoCuenta {
  CAJA
  OFICINA
  BANCO
  ZELLE
  BINANCE
  BILLETERA_BS
  OTRA
}

enum EstadoEntidad {
  ACTIVO
  INACTIVO
}

enum TipoOperacion {
  COMPRA
  VENTA
  OPERACION_DIRECTA
}

enum EstadoOperacion {
  REGISTRADA
  CANCELADA
}

enum TipoEntrada {
  ABONO_CUENTA_PROPIA
  ABONO_DIRECTO_PROVEEDOR
}

enum TipoMovimientoCuenta {
  ENTRADA
  SALIDA
  GASTO
  TRASLADO_ENTRADA
  TRASLADO_SALIDA
  OPERACION_ENTRADA
  OPERACION_SALIDA
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
}

enum TipoMovimientoCliente {
  OPERACION
  ABONO
  PAGO
  ABONO_DIRECTO
  AJUSTE
  CANCELACION
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  OPERADOR
  VISOR
}

enum TipoSalida {
  PAGO_ACREEDOR
  GASTO
  RETIRO
}

enum EstadoSalida {
  REGISTRADA
  CANCELADA
}

enum Modo4x1000Proveedor {
  SUMAR
  RESTAR
}

enum EstadoEntrada {
  REGISTRADA
  CANCELADA
}

enum PeriodoRenovacionTenant {
  MENSUAL
  ANUAL
}

model Tenant {
  id                 String                   @id @default(uuid())
  nombre             String
  slug               String                   @unique
  activo             Boolean                  @default(true)
  fechaActivacion    DateTime                 @default(now())
  fechaRenovacion    DateTime?
  periodoRenovacion  PeriodoRenovacionTenant @default(MENSUAL)
  creadoEn           DateTime                 @default(now())
  actualizadoEn      DateTime                 @updatedAt

  configuracion ConfiguracionOrganizacion?
  usuarios      Usuario[]
  pagos         PagoTenant[]
  cuentas       Cuenta[]
  clientes      Cliente[]
  operaciones   Operacion[]
  entradas      Entrada[]
  salidas       Salida[]
  movimientosCuenta MovimientoCuenta[]
  movimientosCliente MovimientoCliente[]

  @@map("tenants")
}

model PagoTenant {
  id          String   @id @default(uuid())
  tenantId    String
  monto       Decimal  @db.Decimal(18, 2)
  moneda      Moneda   @default(COP)
  fechaPago   DateTime @default(now())
  referencia  String?
  notas       String?
  creadoEn    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pagos_tenants")
}

model Usuario {
  id       String        @id @default(uuid())
  nombre   String
  correo   String        @unique
  password String
  rol      RolUsuario    @default(OPERADOR)
  estado   EstadoEntidad @default(ACTIVO)
  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@map("usuarios")
}

model Cliente {
  id        String        @id @default(uuid())
  nombre    String
  documento String?
  telefono  String?
  notas     String?
  estado    EstadoEntidad @default(ACTIVO)
  tenantId  String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  operacionesComoDeudor   Operacion[] @relation("OperacionDeudor")
  operacionesComoAcreedor Operacion[] @relation("OperacionAcreedor")

  entradasComoDeudor   Entrada[] @relation("EntradaDeudor")
  entradasComoAcreedor Entrada[] @relation("EntradaAcreedor")

  salidasComoAcreedor Salida[] @relation("SalidaAcreedor")

  movimientos MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@map("clientes")
}

model Cuenta {
  id        String          @id @default(uuid())
  nombre    String
  moneda    Moneda
  categoria CategoriaCuenta
  tipo      TipoCuenta
  aplica4x1000 Boolean      @default(false)
  saldo     Decimal         @default(0)
  estado    EstadoEntidad   @default(ACTIVO)
  notas     String?
  tenantId  String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  movimientos MovimientoCuenta[]
  entradas    Entrada[]
  salidas     Salida[]
  operaciones Operacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@map("cuentas")
}

model Operacion {
  id     String @id @default(uuid())
  codigo String @unique
  nombre String
  tenantId String

  tipo   TipoOperacion
  estado EstadoOperacion @default(REGISTRADA)

  deudorId   String?
  acreedorId String?

  monedaTransaccion Moneda
  montoTransaccion  Decimal

  tasaCompra Decimal
  tasaVenta  Decimal

  totalCompraCop Decimal
  totalVentaCop  Decimal
  utilidadCop    Decimal

  cuentaOperativaId String?

  destinatario String?

  fechaOperacion DateTime @default(now())
  notas          String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  deudor   Cliente? @relation("OperacionDeudor", fields: [deudorId], references: [id])
  acreedor Cliente? @relation("OperacionAcreedor", fields: [acreedorId], references: [id])

  cuentaOperativa Cuenta? @relation(fields: [cuentaOperativaId], references: [id])

  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, fechaOperacion])
  @@map("operaciones")
}

model Entrada {
  id String @id @default(uuid())
  tenantId String

  tipo   TipoEntrada
  estado EstadoEntrada @default(REGISTRADA)

  deudorId   String
  acreedorId String?
  cuentaId   String?

  montoCop Decimal

  descripcion String?
  referencia  String?
  notas       String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  deudor   Cliente  @relation("EntradaDeudor", fields: [deudorId], references: [id])
  acreedor Cliente? @relation("EntradaAcreedor", fields: [acreedorId], references: [id])
  cuenta   Cuenta?  @relation(fields: [cuentaId], references: [id])

  aplica4x1000           Boolean  @default(false)
  impuesto4x1000Cop      Decimal  @default(0) @db.Decimal(18, 2)
  montoAplicadoDeudaCop  Decimal? @db.Decimal(18, 2)

  proveedorCobra4x1000       Boolean  @default(false)
  impuestoProveedor4x1000Cop Decimal  @default(0) @db.Decimal(18, 2)
  montoNetoAcreedorCop       Decimal  @default(0) @db.Decimal(18, 2)
  
  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, creadoEn])
  @@index([tenantId, estado])
  @@map("entradas")
}

model Salida {
  id String @id @default(uuid())
  tenantId String

  tipo TipoSalida

  acreedorId String?
  cuentaId   String

  montoCop Decimal

  descripcion String?
  referencia  String?
  notas       String?

  montoBaseCop               Decimal @default(0)
  proveedorCobra4x1000       Boolean @default(false)
  impuestoProveedor4x1000Cop Decimal @default(0)
  montoEnviadoCop            Decimal @default(0)
  cuentaAplica4x1000         Boolean @default(false)
  impuestoCuenta4x1000Cop    Decimal @default(0)
  totalDebitadoCop           Decimal @default(0)

  modo4x1000Proveedor Modo4x1000Proveedor? @default(RESTAR)

  estado EstadoSalida @default(REGISTRADA)

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  acreedor Cliente? @relation("SalidaAcreedor", fields: [acreedorId], references: [id])
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id])

  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, creadoEn])
  @@index([tenantId, estado])
  @@map("salidas")
}

model MovimientoCuenta {
  id String @id @default(uuid())
  tenantId String

  cuentaId String
  tipo     TipoMovimientoCuenta

  monto  Decimal
  moneda Moneda

  saldoAnterior Decimal?
  saldoNuevo    Decimal?

  descripcion    String?
  referenciaTipo String?
  referenciaId   String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cuenta Cuenta @relation(fields: [cuentaId], references: [id])

  creadoEn DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, creadoEn])
  @@map("movimientos_cuentas")
}

model MovimientoCliente {
  id String @id @default(uuid())
  tenantId String

  clienteId String
  tipo      TipoMovimientoCliente

  operacionId String?
  entradaId   String?
  salidaId    String?

  monedaTransaccion Moneda?
  montoTransaccion  Decimal?

  debitoCop  Decimal @default(0)
  creditoCop Decimal @default(0)

  descripcion String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  operacion Operacion? @relation(fields: [operacionId], references: [id])
  entrada   Entrada?   @relation(fields: [entradaId], references: [id])
  salida    Salida?    @relation(fields: [salidaId], references: [id])

  creadoEn DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, creadoEn])
  @@map("movimientos_clientes")
}

model ConfiguracionOrganizacion {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  nombre        String
  logoUrl       String?
  telefono      String?
  correo        String?
  direccion     String?
  monedaBase    Moneda   @default(COP)
  zonaHoraria   String   @default("America/Caracas")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

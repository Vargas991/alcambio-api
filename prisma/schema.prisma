generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Moneda {
  COP
  BS
  USD
  USDT
}

enum CategoriaCuenta {
  BASE_COP
  OPERATIVA
}

enum TipoCuenta {
  CAJA
  OFICINA
  BANCO
  ZELLE
  BINANCE
  BILLETERA_BS
  OTRA
}

enum EstadoEntidad {
  ACTIVO
  INACTIVO
}

enum TipoOperacion {
  COMPRA
  VENTA
  OPERACION_DIRECTA
}

enum EstadoOperacion {
  REGISTRADA
  CANCELADA
}

enum MetodoCalculoOperacion {
  TASA
  PORCENTAJE
}

enum AplicacionPorcentaje {
  SUMAR
  DESCONTAR
}

enum TipoEntrada {
  ABONO_CUENTA_PROPIA
  ABONO_DIRECTO_PROVEEDOR
}

enum TipoMovimientoCuenta {
  ENTRADA
  SALIDA
  GASTO
  TRASLADO_ENTRADA
  TRASLADO_SALIDA
  OPERACION_ENTRADA
  OPERACION_SALIDA
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
}

enum TipoMovimientoCliente {
  OPERACION
  ABONO
  PAGO
  ABONO_DIRECTO
  AJUSTE
  CANCELACION
}

enum RolUsuario {
  ADMIN
  OPERADOR
  VISOR
}

enum TipoSalida {
  PAGO_ACREEDOR
  GASTO
  RETIRO
}

enum EstadoSalida {
  REGISTRADA
  CANCELADA
}

enum EstadoEntrada {
  REGISTRADA
  CANCELADA
}

model Usuario {
  id       String        @id @default(uuid())
  nombre   String
  correo   String        @unique
  password String
  rol      RolUsuario    @default(OPERADOR)
  estado   EstadoEntidad @default(ACTIVO)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("usuarios")
}

model Cliente {
  id        String        @id @default(uuid())
  nombre    String
  documento String?
  telefono  String?
  notas     String?
  estado    EstadoEntidad @default(ACTIVO)

  operacionesComoDeudor   Operacion[] @relation("OperacionDeudor")
  operacionesComoAcreedor Operacion[] @relation("OperacionAcreedor")

  entradasComoDeudor   Entrada[] @relation("EntradaDeudor")
  entradasComoAcreedor Entrada[] @relation("EntradaAcreedor")

  salidasComoAcreedor Salida[] @relation("SalidaAcreedor")

  movimientos MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
  @@map("clientes")
}

model Cuenta {
  id        String          @id @default(uuid())
  nombre    String
  moneda    Moneda
  categoria CategoriaCuenta
  tipo      TipoCuenta

  aplica4x1000 Boolean       @default(false)
  saldo        Decimal       @default(0) @db.Decimal(18, 6)
  estado       EstadoEntidad @default(ACTIVO)
  notas        String?

  movimientos MovimientoCuenta[]
  entradas    Entrada[]
  salidas     Salida[]
  operaciones Operacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([moneda, estado])
  @@map("cuentas")
}

model Operacion {
  id     String @id @default(uuid())
  codigo String @unique
  nombre String

  tipo   TipoOperacion
  estado EstadoOperacion @default(REGISTRADA)

  deudorId   String?
  acreedorId String?

  // Monto principal de la operación.
  monedaTransaccion Moneda
  montoTransaccion  Decimal @db.Decimal(18, 6)

  // Método utilizado para calcular la operación.
  metodoCalculo MetodoCalculoOperacion @default(TASA)

  // Campos utilizados cuando el método es PORCENTAJE.
  porcentaje           Decimal?              @db.Decimal(8, 4)
  aplicacionPorcentaje AplicacionPorcentaje?
  montoComision        Decimal?              @db.Decimal(18, 6)
  montoResultado       Decimal?              @db.Decimal(18, 6)

  // Moneda y monto en los que nace la deuda.
  monedaDeuda Moneda   @default(COP)
  montoDeuda  Decimal? @db.Decimal(18, 6)

  // Copia de la moneda base utilizada al registrar la operación.
  monedaBaseHistorica Moneda @default(COP)

  // Unidades de monedaTransaccion por una unidad de monedaDeuda.
  tasaConversionBase Decimal? @db.Decimal(30, 16)

  // Campos por tasa conservados por compatibilidad.
  tasaCompra Decimal @db.Decimal(18, 8)
  tasaVenta  Decimal @db.Decimal(18, 8)

  totalCompraCop Decimal @db.Decimal(18, 6)
  totalVentaCop  Decimal @db.Decimal(18, 6)
  utilidadCop    Decimal @db.Decimal(18, 6)

  cuentaOperativaId String?
  destinatario      String?

  fechaOperacion DateTime @default(now())
  notas          String?

  deudor   Cliente? @relation("OperacionDeudor", fields: [deudorId], references: [id])
  acreedor Cliente? @relation("OperacionAcreedor", fields: [acreedorId], references: [id])

  cuentaOperativa Cuenta? @relation(fields: [cuentaOperativaId], references: [id])

  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([deudorId, fechaOperacion])
  @@index([acreedorId, fechaOperacion])
  @@index([monedaDeuda, estado])
  @@map("operaciones")
}

model Entrada {
  id String @id @default(uuid())

  tipo   TipoEntrada
  estado EstadoEntrada @default(REGISTRADA)

  deudorId   String
  acreedorId String?
  cuentaId   String?

  // Campo legado. Se conserva para compatibilidad con registros anteriores.
  // Para nuevos abonos multimoneda puede mantenerse en 0.
  montoCop Decimal @default(0) @db.Decimal(18, 6)

  // Dinero recibido físicamente.
  // monedaPago debe coincidir con la moneda de la cuenta receptora.
  monedaPago Moneda  @default(COP)
  montoPago  Decimal @default(0) @db.Decimal(18, 6)

  monedaAplicacion Moneda  @default(COP)
  montoAplicado    Decimal @default(0) @db.Decimal(18, 6)

  // Convención fija:
  // 1 unidad de monedaAplicacion = tasaConversion unidades de monedaPago.
  // Ejemplo: 1 USD = 4.000 COP.
  // montoAplicado = montoPago / tasaConversion.
  // Debe ser null cuando monedaPago == monedaAplicacion.
  tasaConversion Decimal? @db.Decimal(30, 16)

  descripcion String?
  referencia  String?
  notas       String?

  deudor   Cliente  @relation("EntradaDeudor", fields: [deudorId], references: [id])
  acreedor Cliente? @relation("EntradaAcreedor", fields: [acreedorId], references: [id])
  cuenta   Cuenta?  @relation(fields: [cuentaId], references: [id])

  // Campos legados de 4x1000.
  aplica4x1000          Boolean  @default(false)
  impuesto4x1000Cop     Decimal  @default(0) @db.Decimal(18, 2)
  montoAplicadoDeudaCop Decimal? @db.Decimal(18, 2)

  proveedorCobra4x1000       Boolean @default(false)
  impuestoProveedor4x1000Cop Decimal @default(0) @db.Decimal(18, 2)
  montoNetoAcreedorCop       Decimal @default(0) @db.Decimal(18, 2)

  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([deudorId, creadoEn])
  @@index([cuentaId, creadoEn])
  @@index([monedaPago, monedaAplicacion])
  @@map("entradas")
}

model Salida {
  id String @id @default(uuid())

  tipo   TipoSalida
  estado EstadoSalida @default(REGISTRADA)

  acreedorId String?
  cuentaId   String

  // Campo legado.
  montoCop Decimal @default(0) @db.Decimal(18, 6)

  monedaPago Moneda  @default(COP)
  montoPago  Decimal @default(0) @db.Decimal(18, 6)

  monedaAplicacion Moneda  @default(COP)
  montoAplicado    Decimal @default(0) @db.Decimal(18, 6)

  // 1 unidad de monedaAplicacion =
  // tasaConversion unidades de monedaPago.
  tasaConversion Decimal? @db.Decimal(30, 16)

  descripcion String?
  referencia  String?
  notas       String?

  // Campos legados.
  montoBaseCop               Decimal @default(0) @db.Decimal(18, 6)
  proveedorCobra4x1000       Boolean @default(false)
  impuestoProveedor4x1000Cop Decimal @default(0) @db.Decimal(18, 2)
  montoEnviadoCop            Decimal @default(0) @db.Decimal(18, 6)
  cuentaAplica4x1000         Boolean @default(false)
  impuestoCuenta4x1000Cop    Decimal @default(0) @db.Decimal(18, 2)
  totalDebitadoCop           Decimal @default(0) @db.Decimal(18, 6)

  acreedor Cliente? @relation("SalidaAcreedor", fields: [acreedorId], references: [id])
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id])

  movimientosCliente MovimientoCliente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([acreedorId, creadoEn])
  @@index([cuentaId, creadoEn])
  @@index([monedaPago, monedaAplicacion])
  @@map("salidas")
}

model MovimientoCuenta {
  id String @id @default(uuid())

  cuentaId String
  tipo     TipoMovimientoCuenta

  // Movimiento físico en la moneda propia de la cuenta.
  monto  Decimal @db.Decimal(18, 6)
  moneda Moneda

  saldoAnterior Decimal? @db.Decimal(18, 6)
  saldoNuevo    Decimal? @db.Decimal(18, 6)

  descripcion    String?
  referenciaTipo String?
  referenciaId   String?

  cuenta Cuenta @relation(fields: [cuentaId], references: [id])

  creadoEn DateTime @default(now())

  @@index([cuentaId, creadoEn])
  @@index([referenciaTipo, referenciaId])
  @@map("movimientos_cuentas")
}

model MovimientoCliente {
  id String @id @default(uuid())

  clienteId String
  tipo      TipoMovimientoCliente

  operacionId String?
  entradaId   String?
  salidaId    String?

  // Datos físicos/originales de la transacción.
  monedaTransaccion Moneda?
  montoTransaccion  Decimal? @db.Decimal(18, 6)

  // Campos legados COP.
  debitoCop  Decimal @default(0) @db.Decimal(18, 6)
  creditoCop Decimal @default(0) @db.Decimal(18, 6)

  // Efecto contable real sobre el saldo del cliente.
  // El saldo por moneda se calcula como SUM(debito - credito).
  moneda  Moneda  @default(COP)
  debito  Decimal @default(0) @db.Decimal(18, 6)
  credito Decimal @default(0) @db.Decimal(18, 6)

  // Valores opcionales de auditoría para evitar recalcular el saldo
  // inmediatamente anterior y posterior al movimiento.
  saldoAnterior Decimal? @db.Decimal(18, 6)
  saldoNuevo    Decimal? @db.Decimal(18, 6)

  descripcion String?

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  operacion Operacion? @relation(fields: [operacionId], references: [id])
  entrada   Entrada?   @relation(fields: [entradaId], references: [id])
  salida    Salida?    @relation(fields: [salidaId], references: [id])

  creadoEn DateTime @default(now())

  @@index([clienteId, moneda, creadoEn])
  @@index([entradaId])
  @@index([salidaId])
  @@index([operacionId])
  @@map("movimientos_clientes")
}

model ConfiguracionOrganizacion {
  id        String  @id @default(uuid())
  nombre    String
  logoUrl   String?
  telefono  String?
  correo    String?
  direccion String?

  // Moneda predeterminada para operaciones, deudas y dashboard.
  monedaBase Moneda @default(COP)

  zonaHoraria String @default("America/Caracas")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}
